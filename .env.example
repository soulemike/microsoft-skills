# Microsoft Cloud API Skills - Environment Template
# Copy to .env and fill in actual values (never commit .env)

# Microsoft Entra ID / Azure AD
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=your-client-secret-here

# Certificate-based authentication (alternative to client secret)
CERTIFICATE_THUMBPRINT=YOUR_CERT_THUMBPRINT
CERTIFICATE_PATH=/path/to/certificate.pfx
CERTIFICATE_PASSWORD=your-cert-password

# Azure Environment
# Options: AzureCloud, AzureUSGovernment, AzureChinaCloud, AzureGermanCloud
AZURE_ENVIRONMENT=AzureCloud

# Dataverse / Power Platform
DATAVERSE_ENVIRONMENT_URL=https://your-org.crm.dynamics.com
POWER_PLATFORM_ENVIRONMENT_ID=your-environment-id

# Azure Resource Manager
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Optional: Azure Key Vault for secret retrieval
KEY_VAULT_NAME=your-keyvault-name
KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# Optional: Managed Identity (when running on Azure resources)
# Set USE_MANAGED_IDENTITY=true to skip client secret/cert
USE_MANAGED_IDENTITY=false
MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: Government Cloud endpoints
# USGov Graph: https://graph.microsoft.us
# USGov ARM: https://management.usgovcloudapi.net
GRAPH_ENDPOINT=https://graph.microsoft.com
ARM_ENDPOINT=https://management.azure.com
